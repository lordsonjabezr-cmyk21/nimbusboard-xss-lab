# ==============================================================================
# NimbusBoard XSS Training Laboratory — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Laboratory Operation Mode
# - 'vulnerable': Enables intentional educational XSS vulnerabilities across all 10 categories
# - 'fixed': Applies secure defenses (contextual escaping, DOMPurify, strict CSP, scheme validation)
LAB_MODE=vulnerable

# Educational Hints
# - 'on': Enables contextual hints in the UI and via GET /lab/hints/:id
# - 'off': Disables hint endpoints and UI references for assessment mode
LAB_HINTS=on

# Environment Profile
# - 'training': Local training mode; allows simplified dev tokens (token-ari, token-noah, token-mira)
# - 'production': Strict mode; training shortcuts disabled, strong JWT_SECRET strictly enforced
LAB_PROFILE=training

# Training Token Shortcuts (Active only when LAB_PROFILE=training)
# Set to 'false' to require standard signed JWT authentication even during local training
ALLOW_DEV_TOKENS=true

# Server Network Configuration
PORT=4000
HOST=127.0.0.1

# Frontend URL (Used for CORS allowlist and links)
FRONTEND_URL=http://127.0.0.1:3000

# JSON Web Token Secret
# In 'production' profile: REQUIRED. Must be at least 32 characters long.
# In 'training' profile: Optional. If omitted, an ephemeral cryptographically random
# secret is generated automatically for the runtime session.
# Example production placeholder:
# JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_key!
JWT_SECRET=

# Database Configuration (PostgreSQL)
# In standard Docker deployment, PostgreSQL runs on internal network 'db:5432'.
# If running API locally without Docker, point to local PostgreSQL instance,
# or leave blank to use the built-in in-memory fallback store for offline tests.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nimbusboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nimbusboard

# Out-Of-Band (OOB) Callback Listener URL (Category 5 Blind XSS)
# Dispatches only static event notifications ({ "event": "feedback-submitted", "id": N }).
OOB_URL=http://127.0.0.1:5000/callback
